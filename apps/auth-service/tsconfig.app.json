{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "out-tsc/auth-service",
        "types": ["node"],
        "rootDir": "../../",
        "tsBuildInfoFile": "out-tsc/auth-service/tsconfig.app.tsbuildinfo"
    },
    "include": ["src/**/*.ts", "../../packages/**/*.ts", "src/**/*.json"],
    "exclude": [
        "out-tsc",
        "dist",
        "jest.config.ts",
        "jest.config.cts",
        "src/**/*.spec.ts",
        "src/**/*.test.ts",
        "eslint.config.js",
        "eslint.config.cjs",
        "eslint.config.mjs"
    ],
    "references": [
        {
            "path": "../../packages/error-handler/tsconfig.lib.json"
        }
    ]
}
